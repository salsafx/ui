{
  "name": "@salsafx/ui",
  "version": "16.48.0",
  "description": "SalsaFX UI components (AGPL-3.0)",
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react-elements.js",
      "types": "./dist/react-elements.d.ts"
    },
    "./solid": {
      "import": "./dist/solid-elements.js",
      "types": "./dist/solid-elements.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "custom-elements.json",
    "html-data"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "lit": "^3.3.3",
    "react": "^19.0.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salsafx/ui.git"
  }
}
